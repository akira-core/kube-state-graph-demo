# Local build scratch.
#
# This also covers charts/ksg-demo/charts/*.tgz, which is what we want: the
# first-party subcharts are repackaged from charts/<name>/ on every
# `make deps`, and a committed copy would be a second, staler source of truth.
# The UPSTREAM subcharts are not archives — they are vendored unpacked as
# directories, so they are tracked and diffable.
*.tgz
.DS_Store

# Playwright MCP scratch.
.playwright-mcp/
